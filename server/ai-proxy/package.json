{
  "name": "@convoautopsy/ai-proxy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings=0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.68",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.4",
    "globals": "^16.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.14.1",
    "zod": "^3.24.3"
  },
  "vitest": {
    "pool": "@cloudflare/vitest-pool-workers",
    "poolOptions": {
      "workers": {
        "wrangler": {
          "configPath": "./wrangler.jsonc"
        },
        "miniflare": {
          "kvNamespaces": [
            "RATE_LIMITS"
          ]
        }
      }
    }
  }
}
