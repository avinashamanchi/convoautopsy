{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "convoautopsy-ai-proxy-local-load-fixture",
  "main": "src/loadFixture.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "ENTITLEMENT_CACHE" }
  ],
  "vars": {
    "MAX_GLOBAL_IN_FLIGHT": "100",
    "MAX_DAILY_PROVIDER_UNITS": "1300000"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimitDurableObject" },
      { "name": "AI_ADMISSION", "class_name": "AdmissionDurableObject" },
      { "name": "LOAD_CONTROL", "class_name": "LoadControlDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimitDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["AdmissionDurableObject"] },
    { "tag": "v3", "new_sqlite_classes": ["LoadControlDurableObject"] }
  ]
}
